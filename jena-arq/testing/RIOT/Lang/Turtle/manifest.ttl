PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>

PREFIX rdft:   <http://www.w3.org/ns/rdftest#>

<>  rdf:type mf:Manifest ;
    rdfs:comment "Turtle tests (Additional tests)" ;
    mf:entries
    (
       <#turtle-eval-extra-01>
       <#turtle-eval-extra-02>
       <#turtle-eval-extra-03>

       ## 3000 would otherwise likely cause a stack overflow.

       <#turtle-nested-500-collection>
       <#turtle-nested-1000-collection>
       <#turtle-nested-3000-collection>

       <#turtle-nested-500-pred-obj-list>
       <#turtle-nested-1000-pred-obj-list>
       <#turtle-nested-3000-pred-obj-list>

       <#turtle-nested-500-reified-triple>
       <#turtle-nested-1000-reified-triple>
       <#turtle-nested-3000-reified-triple>

       <#turtle-nested-500-triple-term>
       <#turtle-nested-1000-triple-term>
       <#turtle-nested-3000-triple-term>

       <#turtle-nested-500-annotations>
       <#turtle-nested-1000-annotations>
       <#turtle-nested-3000-annotations>
    ) .

<#turtle-eval-extra-01> rdf:type rdft:TestTurtleEval ;
   mf:name    "turtle-eval-extra-01" ;
   mf:action    <turtle-eval-extra-01.ttl> ;
   mf:result    <turtle-eval-extra-01.nt> ;
   .

<#turtle-eval-extra-02> rdf:type rdft:TestTurtleEval ;
   mf:name    "turtle-eval-extra-02" ;
   mf:action    <turtle-eval-extra-02.ttl> ;
   mf:result    <turtle-eval-extra-02.nt> ;
   .

<#turtle-eval-extra-03> rdf:type rdft:TestTurtleEval ;
   mf:name    "turtle-eval-extra-03" ;
   mf:action    <turtle-eval-extra-03.ttl> ;
   mf:result    <turtle-eval-extra-03.nt> ;
   .


## Nested structures

<#turtle-nested-500-collection> rdf:type rdft:TestTurtlePositiveSyntax ;
   mf:name    "nested-500-collection.ttl" ;
   mf:action  <nested-500-collection.ttl> ;
   .

<#turtle-nested-1000-collection> rdf:type rdft:TestTurtleNegativeSyntax ;
   mf:name    "nested-1000-collection.ttl" ;
   mf:action  <nested-1000-collection.ttl> ;
   .

<#turtle-nested-3000-collection> rdf:type rdft:TestTurtleNegativeSyntax ;
   mf:name    "nested-3000-collection.ttl" ;
   mf:action  <nested-3000-collection.ttl> ;
   .

<#turtle-nested-500-pred-obj-list>  rdf:type rdft:TestTurtlePositiveSyntax ;
   mf:name    "nested-500-pred-obj-list.ttl" ;
   mf:action  <nested-500-pred-obj-list.ttl> ;
   .

<#turtle-nested-1000-pred-obj-list>  rdf:type rdft:TestTurtleNegativeSyntax ;
   mf:name    "nested-1000-pred-obj-list.ttl" ;
   mf:action  <nested-1000-pred-obj-list.ttl> ;
   .

<#turtle-nested-3000-pred-obj-list>  rdf:type rdft:TestTurtleNegativeSyntax ;
   mf:name    "nested-3000-pred-obj-list.ttl" ;
   mf:action  <nested-3000-pred-obj-list.ttl> ;
   .

<#turtle-nested-500-reified-triple>  rdf:type rdft:TestTurtlePositiveSyntax ;
   mf:name    "nested-500-reified-triple.ttl" ;
   mf:action  <nested-500-reified-triple.ttl> ;
   .

<#turtle-nested-1000-reified-triple>  rdf:type rdft:TestTurtleNegativeSyntax ;
   mf:name    "nested-1000-reified-triple.ttl" ;
   mf:action  <nested-1000-reified-triple.ttl> ;
   .

<#turtle-nested-3000-reified-triple>  rdf:type rdft:TestTurtleNegativeSyntax ;
   mf:name    "nested-3000-reified-triple.ttl" ;
   mf:action  <nested-3000-reified-triple.ttl> ;
   .

<#turtle-nested-500-triple-term>  rdf:type rdft:TestTurtlePositiveSyntax ;
   mf:name    "nested-500-triple-term.ttl" ;
   mf:action  <nested-500-triple-term.ttl> ;
   .

<#turtle-nested-1000-triple-term>  rdf:type rdft:TestTurtleNegativeSyntax ;
   mf:name    "nested-1000-triple-term.ttl" ;
   mf:action  <nested-1000-triple-term.ttl> ;
   .

<#turtle-nested-3000-triple-term>  rdf:type rdft:TestTurtleNegativeSyntax ;
   mf:name    "nested-3000-triple-term.ttl" ;
   mf:action  <nested-3000-triple-term.ttl> ;
   .

<#turtle-nested-500-annotations>  rdf:type rdft:TestTurtlePositiveSyntax ;
   mf:name    "nested-500-annotations.ttl" ;
   mf:action  <nested-500-annotations.ttl> ;
   .

<#turtle-nested-1000-annotations>  rdf:type rdft:TestTurtleNegativeSyntax ;
   mf:name    "nested-1000-annotations.ttl" ;
   mf:action  <nested-1000-annotations.ttl> ;
   .

<#turtle-nested-3000-annotations>  rdf:type rdft:TestTurtleNegativeSyntax ;
   mf:name    "nested-3000-annotations.ttl" ;
   mf:action  <nested-3000-annotations.ttl> ;
   .
