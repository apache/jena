# GH-4240: GROUP_CONCAT(DISTINCT ...) over an empty group is the empty string,
# the same as GROUP_CONCAT(...).
SELECT (GROUP_CONCAT(DISTINCT ?v) AS ?distinct) (GROUP_CONCAT(?v) AS ?plain)
WHERE { ?s <urn:p> ?v . ?s <urn:q> ?tag . }
